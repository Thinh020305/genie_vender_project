// 1. Quản lý người dùng & Phân quyền
Table members {
  id int [pk, increment]
  email varchar [unique, not null]
  password varchar [not null]
  name varchar [not null]
  role enum('ADMIN', 'DEVELOPER', 'REVIEWER') [not null]
  createdAt timestamp [default: `now()`]
}

// 2. Danh mục (Catalogs) - Giúp dữ liệu chuẩn hóa
Table locations {
  id int [pk, increment]
  name varchar [unique, not null] // Hanoi, HCMC, Da Nang...
}

Table technologies {
  id int [pk, increment]
  name varchar [unique, not null] // React, Node.js, Java...
}

Table languages {
  id int [pk, increment]
  name varchar [unique, not null] // English, Korean, Japanese...
}

// 3. Thực thể chính: Vendor
Table vendors {
  id int [pk, increment]
  vendorCode varchar [unique, not null]
  companyName varchar [not null]
  website varchar
  locationId int [ref: > locations.id]
  serviceType enum('OUTSOURCING', 'SI', 'PRODUCT', 'CONSULTING', 'SPECIALIZED_TECH')
  industryExperience text
  companySize varchar
  classificationId int [ref: > classification_rules.id] // Link trực tiếp tới tiêu chí
  note text
  createdAt timestamp [default: `now()`]
  updatedAt timestamp
  deletedAt timestamp // Soft delete
}

// 4. Các bảng quan hệ N:M (Junction Tables)
Table vendor_technologies {
  vendorId int [ref: > vendors.id]
  technologyId int [ref: > technologies.id]
  primary key (vendorId, technologyId)
}

Table vendor_languages {
  vendorId int [ref: > vendors.id]
  languageId int [ref: > languages.id]
  primary key (vendorId, languageId)
}

// 5. Nguồn bằng chứng (Evidence)
Table vendor_sources {
  id int [pk, increment]
  vendorId int [ref: > vendors.id]
  sourceType enum('PUBLIC_WEBSITE', 'DIRECTORY', 'LINKEDIN', 'ARTICLE', 'DEMO_DATA')
  sourceUrl varchar
  sourceTitle varchar
  checkedAt timestamp
  memo text
}

// 6. Quy tắc & Lịch sử phân loại
Table classification_rules {
  id int [pk, increment]
  classificationName varchar [unique] // Outsourcing Vendor, SI Company...
  description text
  judgmentCriteria text
}

Table classification_histories {
  id int [pk, increment]
  vendorId int [ref: > vendors.id]
  changedBy int [ref: > members.id]
  previousClassification varchar
  newClassification varchar
  reason text
  changedAt timestamp [default: `now()`]
}

// 7. Tóm tắt AI/Manual
Table vendor_summaries {
  id int [pk, increment]
  vendorId int [ref: > vendors.id]
  summaryType enum('PROFILE_SUMMARY', 'LLM_SUMMARY', 'MANUAL_NOTE')
  content text
  createdBy int [ref: > members.id]
  createdAt timestamp [default: `now()`]
}