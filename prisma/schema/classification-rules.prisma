// Danh mục tiêu chí phân loại, mỗi VendorClassification một dòng.
model ClassificationRule {
  id Int @id @default(autoincrement())

  classificationName VendorClassification @unique

  description      String? @db.VarChar(500)
  judgmentCriteria String? @db.VarChar(1000)

  // Dạng máy đọc được của judgmentCriteria, dùng cho RuleMatcherService.
  keywords String[]

  // Phá hoà khi vendor khớp nhiều tiêu chí: priority tăng, weight giảm.
  priority Int @default(100)
  weight   Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([priority])
  @@map("classification_rules")
}
