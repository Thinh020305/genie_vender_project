model ClassificationRule {
  id                 Int                  @id @default(autoincrement())
  classificationName VendorClassification @unique
  description        String               @db.Text
  judgmentCriteria   String               @db.Text
  createdAt          DateTime             @default(now()) @db.Timestamptz

  vendors                 Vendor[]                @relation("VendorClassification")
  previousClassifications ClassificationHistory[]  @relation("PreviousClassification")
  newClassifications      ClassificationHistory[]  @relation("NewClassification")

  @@map("classification_rules")
}

